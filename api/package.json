{
  "name": "api",
  "version": "0.0.1",
  "description": "TwitterMF HTTP API (NestJS + Fastify)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lab:bloom": "tsx scripts/bloom-experiment.ts",
    "lab:stampede": "tsx scripts/stampede-experiment.ts",
    "lab:ratelimit": "tsx scripts/rate-limit-experiment.ts",
    "db:seed": "tsx scripts/seed.ts",
    "counters:reconcile": "tsx scripts/reconcile-counters.ts",
    "jobs": "tsx scripts/jobs.ts",
    "worker": "node dist/worker",
    "worker:dev": "tsx watch --clear-screen=false src/worker.ts",
    "lab:fanout": "tsx scripts/fanout-experiment.ts",
    "search:reindex": "tsx scripts/reindex-search.ts",
    "lab:breaker": "tsx scripts/breaker-experiment.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fastify/cookie": "^11.1.3",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.1.3",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.15",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "meilisearch": "^0.62.0",
    "nestjs-pino": "^5.3.1",
    "opossum": "^10.0.0",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^24.0.0",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.58.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
