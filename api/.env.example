NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://twitter:twitter@localhost:5432/twitter
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=info
WORKER_ID=0
# Dev-only secret. Generate a fresh one for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
# Accounts with this many followers are merged into timelines at read time
# instead of fanned out (the hybrid). The seed's celebrities have ~55, so 40
# lets you see it locally; production would use ~10000.
FANOUT_MAX_FOLLOWERS=40
# Object storage (RustFS locally; Cloudflare R2 in production) and search.
# The defaults match infra/docker-compose.yml, so these can stay commented.
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
# STORAGE_BUCKET=twittermf
# MEDIA_BASE_URL=http://localhost:9000/twittermf
# MEILI_URL=http://localhost:7700
# MEILI_KEY=twitter-dev-master-key
