{
  "name": "twittermf",
  "private": true,
  "description": "A scalable Twitter clone built on free tools, one distributed-systems concept at a time.",
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w api",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate -w api",
    "db:migrate": "npm run db:migrate -w api",
    "db:studio": "npm run db:studio -w api",
    "setup": "npm install && ([ -f api/.env ] || cp api/.env.example api/.env) && ([ -f web/.env.local ] || cp web/.env.example web/.env.local)",
    "lab:explain": "docker exec -i twittermf-postgres-1 psql -U twitter -d twitter -f - < api/scripts/explain-timeline.sql",
    "lab:bloom": "npm run lab:bloom --silent -w api",
    "lab:stampede": "npm run lab:stampede --silent -w api",
    "lab:ratelimit": "npm run lab:ratelimit --silent -w api",
    "db:seed": "npm run db:seed --silent -w api --",
    "counters:reconcile": "npm run counters:reconcile --silent -w api",
    "dev:stop": "node scripts/dev-stop.mjs",
    "jobs": "npm run jobs --silent -w api --",
    "lab:fanout": "npm run lab:fanout --silent -w api",
    "search:reindex": "npm run search:reindex --silent -w api"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
